<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layoutDirection="ltr"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:id="@+id/client"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/cardcolor"
        android:elevation="10dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_margin="8dp"
        android:id="@+id/aaaa"
        android:padding="10dp"
        android:layout_height="wrap_content">



        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_height="wrap_content">


            <LinearLayout
                android:id="@+id/training_arealay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Training area:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

                <TextView
                    android:id="@+id/training_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_height="wrap_content">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Advisor name:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:id="@+id/name"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_height="wrap_content">




                <TextView
                    android:layout_width="match_parent"
                    android:autoLink="phone"
                    android:text="Mobile:"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:textDirection="ltr"
                    android:textSize="13dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:autoLink="phone"
                    android:layout_marginTop="8dp"
                    android:id="@+id/mobile"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp"
                    android:layout_height="wrap_content" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_height="wrap_content">




                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="E-Mail:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />



                <TextView
                    android:layout_width="match_parent"
                    android:id="@+id/email"
                    android:autoLink="email"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp"
                    android:layout_height="wrap_content" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:weightSum="2"
                tools:visibility="gone">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Password:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

                <TextView
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:weightSum="2"
                android:id="@+id/departmentlay"
                android:layout_height="wrap_content">





                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Department:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:id="@+id/department"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/addresslay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Address:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

                <TextView
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Username:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />


                <TextView
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/statuslay"
                android:weightSum="2">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1.4"
                    android:text="Status:"
                    android:textColor="@color/colorPrimary"
                    android:textDirection="ltr"
                    android:textSize="13dp" />


                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="0.6"
                    android:textDirection="ltr"
                    android:textSize="13dp" />


            </LinearLayout>


            <Button
                android:id="@+id/activeinactive"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/btnround"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:text="Active"/>

            <Button
                android:id="@+id/rates"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/btnround"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:text="Rates"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="40dp"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/delete" />


            <ImageView
                android:id="@+id/chat"
                android:layout_width="40dp"
                android:layout_marginTop="20dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/chat" />



        </LinearLayout>


    </LinearLayout>



    </androidx.cardview.widget.CardView>

</RelativeLayout>